<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tanba</RootNamespace>
    <AssemblyName>Tanba</AssemblyName>
    <!-- Запасное значение для отладочной сборки. Настоящую версию релиза
         задаёт build.ps1 через /p:Version, и она же уходит в имя пакета,
         поэтому править её здесь бесполезно. -->
    <Version>0.1.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Требуется генератору LibraryImport для P/Invoke в Shell/Native.cs -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Хост окна: WinForms несёт WebView2 и System.Drawing для эскизов -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Значок вшивается в exe: его показывает проводник, панель задач
         и ярлыки. Окно берёт его же из себя, см. MainWindow, чтобы значок
         жил в одном месте, а не в двух. -->
    <ApplicationIcon>..\..\assets\tanba.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- Куда программа ходит за обновлением. Вшивается при сборке, чтобы
       человеку не пришлось ничего вписывать руками.

       Ключ пуст и таким должен остаться: репозиторий публичный, релизы
       читаются без него, и в раздаваемом exe нет никакого секрета.
       Переменная TANBA_UPDATE_TOKEN оставлена на случай, если репозиторий
       когда-нибудь закроют. Учти тогда, что вшитый ключ достаётся из exe,
       поэтому он обязан быть только на чтение и только на этот репозиторий. -->
  <PropertyGroup>
    <TanbaUpdateRepo Condition="'$(TanbaUpdateRepo)' == ''">https://github.com/amanaotoko/tanba</TanbaUpdateRepo>
    <TanbaUpdateToken Condition="'$(TanbaUpdateToken)' == ''">$(TANBA_UPDATE_TOKEN)</TanbaUpdateToken>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>UpdateRepo</_Parameter1>
      <_Parameter2>$(TanbaUpdateRepo)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>UpdateToken</_Parameter1>
      <_Parameter2>$(TanbaUpdateToken)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Схема вшита в сборку: exe самодостаточен, файл рядом не нужен -->
    <EmbeddedResource Include="..\..\schema.sql" LogicalName="Tanba.schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Интерфейс отдаётся статикой из tanba/ui -->
    <Content Include="..\..\ui\**\*" LinkBase="ui" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
